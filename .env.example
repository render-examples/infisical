# Nothing is asked for on deploy.
#
# Set by the Blueprint: DB_CONNECTION_URI, REDIS_URL, SITE_URL, NODE_ENV,
# TELEMETRY_ENABLED, ENCRYPTION_SEED (generated), AUTH_SECRET (generated).
# ENCRYPTION_KEY is derived from ENCRYPTION_SEED by the start command.
#
# Optional, add on the infisical service after deploy:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=infisical@example.com
# SMTP_FROM_NAME=Infisical
